{
  "name": "bb-nufflizier",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "node scripts/build-analyzer.mjs && next dev",
    "build": "node scripts/build-analyzer.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-analyzer.mjs && node scripts/run-unit-gates.mjs",
    "test:nufflizier": "corepack pnpm test && corepack pnpm test:e2e",
    "test:legacy": "vitest run tests/unit/analyzeReplay.test.ts tests/unit/coachingOutput.test.ts tests/unit/teamScoping.test.ts tests/unit/demoReplayStructured.test.ts tests/unit/rulesPlayerLinking.test.ts tests/unit/legacyReplayApiRoute.test.ts",
    "test:quota": "node --import tsx scripts/verify-shared-quota.ts",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build-analyzer.mjs && next build && node scripts/run-e2e-gates.mjs",
    "nufflizier": "node scripts/build-analyzer.mjs && node --import tsx src/cli/nufflizier.ts",
    "prepare:analyzer": "node scripts/build-analyzer.mjs",
    "verify": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm test:quota && corepack pnpm test:e2e"
  },
  "bin": {
    "nufflizier": "./bin/nufflizier"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "saxes": "6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "0.27.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.32"
    }
  }
}
